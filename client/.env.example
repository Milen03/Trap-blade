# Копирай този файл като .env.local (в папка client/) и попълни стойностите.
# .env.local не се качва в git. Всичко с префикс VITE_ се вижда в браузъра —
# тук слагай само публични стойности (Client ID-тата са публични, тайните — НЕ).

# Адрес на API-то в production. В development остави празно — Vite препраща /api към localhost:3000.
VITE_API_URL=

# Google: OAuth Client ID (тип "Web application") от Google Cloud Console -> APIs & Services -> Credentials.
# В "Authorized JavaScript origins" добави http://localhost:5173, http://localhost и адреса на сайта в production.
VITE_GOOGLE_CLIENT_ID=

# Apple: Services ID от Apple Developer -> Identifiers (например bg.trapblade.web).
# Apple НЕ работи на localhost — нужни са HTTPS домейн и Return URL, добавени в Apple Developer.
VITE_APPLE_CLIENT_ID=
# Return URL, регистриран в Apple. Ако е празно, се ползва адресът на сайта (window.location.origin).
VITE_APPLE_REDIRECT_URI=
