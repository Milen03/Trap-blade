# Копирай този файл като .env.local (в папка client/) и попълни стойностите.
# .env.local не се качва в git. Всичко с префикс VITE_ се вижда в браузъра —
# тук слагай само публични стойности, никакви тайни.

# Адрес на API-то в production. В development остави празно — Vite препраща /api към localhost:3000.
VITE_API_URL=

# Вход с Google: OAuth Client ID (тип "Web application") от Google Cloud Console.
# Същата стойност е GOOGLE_CLIENT_ID на сървъра (Railway). Ако е празно, бутонът "Продължи с Google" не се показва.
# Във Vercel я задаваш в Environment Variables и правиш Redeploy (Vite я вгражда при build).
VITE_GOOGLE_CLIENT_ID=
