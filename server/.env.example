# Копирай този файл като .env (в папка server/) и попълни стойностите.
# .env НЕ се качва в git.

# Тайна за подписване на нашите JWT токени — сложи дълъг случаен низ.
SECRET=smeni-me-s-dulga-sluchaina-tajna
COOKIESECRET=smeni-me-i-tova

# Връзка с MongoDB в production (в development се ползва mongodb://localhost:27017/forum).
DB_URL_CREDENTIALS=

# Адрес(и) на клиента в production, разделени със запетая (за CORS).
# Пример: CLIENT_ORIGIN=https://trapblade.vercel.app
CLIENT_ORIGIN=

# Вход с Google: OAuth Client ID (тип "Web application") от Google Cloud Console.
# Същата стойност отива и в client/.env.local като VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# Вход с Apple: Services ID от Apple Developer (например bg.trapblade.web).
# Същата стойност отива и в client/.env.local като VITE_APPLE_CLIENT_ID.
APPLE_CLIENT_ID=
