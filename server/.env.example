# Копирай този файл като .env (в папка server/) и попълни стойностите.
# .env НЕ се качва в git.

# Тайна за подписване на нашите JWT токени — сложи дълъг случаен низ.
SECRET=smeni-me-s-dulga-sluchaina-tajna
COOKIESECRET=smeni-me-i-tova

# Връзка с MongoDB в development. Ако е празно: mongodb://localhost:27017/trapblade
DB_URL=

# Връзка с MongoDB в production.
DB_URL_CREDENTIALS=

# Адрес(и) на клиента в production, разделени със запетая (за CORS).
# Пример: CLIENT_ORIGIN=https://trapblade.vercel.app
CLIENT_ORIGIN=

# Адрес на сайта — от него се правят линковете в писмата (например за нова парола).
# В development, ако е празно: http://localhost:5173. В production: първият адрес от CLIENT_ORIGIN.
CLIENT_URL=

# Имейли (забравена парола) през https://resend.com. Ако RESEND_API_KEY е празно,
# писмата НЕ се пращат, а само се печатат в терминала на сървъра (удобно за разработка).
RESEND_API_KEY=
# Подател — трябва да е от домейн, потвърден в Resend. Пример: TrapBlade <no-reply@trapblade.bg>
MAIL_FROM=

# Профили на собственика и бръснарите за "npm run seed".
# Ако имейлът вече е регистриран, скриптът само му слага ролята (паролата не се променя).
# Ако го няма — създава профил с тази парола (поне 6 символа). Имената не са задължителни.
SEED_OWNER_EMAIL='milen.atanasovv03@gmail.com'
SEED_OWNER_PASSWORD='717503'
SEED_OWNER_FIRST_NAME='Milen'
SEED_OWNER_LAST_NAME='Atanasov'

